<%- include('parts/topbar') %><main class="page"><div class="card"><h1>Farius Chat</h1><p class="muted">The same real-time chat system is available from the top Chat button.</p><button class="primary" id="open">Open Chat</button></div></main><div id="chatModal" class="modal open"><div class="modal-box chat-window"><a class="close" href="/">✕</a><h2>Farius Chat</h2><div id="messages" class="messages"></div><div class="chat-compose"><input id="chatInput" placeholder="Sign in and type..."><button class="primary" id="sendChat">Send</button></div></div></div><div id="authModal" class="modal"><div class="modal-box"><button class="close" id="closeAuth">✕</button><h2 id="authTitle">Sign in</h2><div class="field"><label>Username</label><input id="authUser"></div><div class="field"><label>Password</label><input id="authPass" type="password"></div><button class="primary" id="authSubmit">Sign in</button><button id="switchAuth">Create account</button><p id="authError" class="muted"></p></div></div><script src="/socket.io/socket.io.js"></script><script type="module" src="/js/app.js"></script>