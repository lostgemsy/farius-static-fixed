<%- include('parts/topbar') %><main class="page"><h1>🏆 Leaderboard</h1><p class="muted">Top submitted game scores.</p><div id="leaderboard" class="list"></div></main><script type="module">async function load(){const r=await fetch('/api/leaderboard');const d=await r.json();const el=document.querySelector('#leaderboard');el.innerHTML=d.length?d.slice(0,100).map((x,i)=>`<div class="row"><b>#${i+1} ${esc(x.username)}</b><span>${esc(x.game)} — <strong>${Number(x.score).toLocaleString()}</strong></span></div>`).join(''):'<div class="card">No scores yet.</div>'}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}load();</script>