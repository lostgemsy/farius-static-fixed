
<style>
:root{--bg:#050608;--panel:rgba(14,16,21,.88);--line:rgba(255,255,255,.1);--text:#f5f7fb;--muted:#9da5b4;--accent:#5ea7ff}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,Arial;background:#050608;color:var(--text)}
body{background:radial-gradient(circle at 50% -10%,#18243b 0,#080a0e 45%,#030405 100%);background-attachment:fixed}
a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}
.top{height:64px;position:fixed;top:0;left:0;right:0;z-index:20;display:flex;align-items:center;justify-content:center;background:rgba(4,5,7,.72);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.nav{display:flex;gap:8px;align-items:center}.nav a,.nav button{border:1px solid transparent;background:transparent;color:#dce2ec;padding:9px 14px;border-radius:12px;cursor:pointer}.nav a:hover,.nav button:hover{background:rgba(255,255,255,.07);border-color:var(--line)}
.brand{position:absolute;left:22px;font-weight:800;letter-spacing:.4px}.account{position:absolute;right:18px;display:flex;gap:8px;align-items:center}
.page{max-width:1180px;margin:0 auto;padding:100px 22px 50px}.hero{text-align:center;padding:60px 10px 35px}.hero h1{font-size:clamp(38px,7vw,76px);margin:0 0 12px}.hero p{color:var(--muted);font-size:18px}.search{max-width:760px;margin:28px auto;display:flex;background:#10131a;border:1px solid var(--line);padding:7px;border-radius:18px;box-shadow:0 20px 70px rgba(0,0,0,.3)}.search input{flex:1;background:transparent;border:0;outline:0;color:white;padding:13px 15px}.search button,.primary{border:0;background:var(--accent);color:#07111f;font-weight:800;padding:12px 18px;border-radius:13px;cursor:pointer}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px;min-height:120px}.card h3{margin-top:0}.muted{color:var(--muted)}.pill{display:inline-flex;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.07);font-size:13px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(10px);z-index:100;display:none;align-items:center;justify-content:center;padding:18px}.modal.open{display:flex}.modal-box{width:min(620px,100%);max-height:90vh;overflow:auto;background:#0c0f14;border:1px solid var(--line);border-radius:22px;padding:22px;box-shadow:0 30px 100px #000}.close{float:right;border:0;background:#fff1;color:white;border-radius:10px;padding:8px;cursor:pointer}
.chat-window{height:min(70vh,650px);display:flex;flex-direction:column}.messages{flex:1;overflow:auto;padding:10px;border:1px solid var(--line);border-radius:15px;background:#080a0d}.msg{padding:8px 10px;margin:4px 0;border-radius:12px;background:#10141b}.msg b{color:#8ebcff}.chat-compose{display:flex;gap:8px;margin-top:10px}.chat-compose input{flex:1}.field{display:flex;flex-direction:column;gap:7px;margin:10px 0}.field input,.field textarea,.field select{background:#080a0e;color:white;border:1px solid var(--line);border-radius:12px;padding:12px;outline:none}.tabs{display:flex;gap:8px;margin-bottom:12px}.danger{background:#e85b6a!important;color:white!important}.list{display:grid;gap:10px}.row{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:14px;background:#0b0e13}.game-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}.game{padding:18px;border-radius:16px;background:#0c1016;border:1px solid var(--line);cursor:pointer}.game:hover{transform:translateY(-2px);border-color:#ffffff30}.game-frame{width:100%;height:70vh;border:1px solid var(--line);border-radius:18px;background:#000}.hidden{display:none!important}
@media(max-width:700px){.brand{display:none}.nav{gap:2px}.nav a,.nav button{padding:8px}.page{padding-left:12px;padding-right:12px}}
</style>

<header class="top"><a class="brand" href="/">FARIUS</a><nav class="nav">
<a href="/">Home</a><a href="/games">Games</a><a href="/leaderboard">Leaderboard</a><button id="openChat">Chat</button><a href="/suggest">Suggest</a><a href="/settings">Settings</a>
</nav><div class="account"><button id="friendBell" title="Friend requests">🔔</button><span id="userLabel" class="muted">Guest</span><button id="authBtn">Sign in</button></div></header>
<div id="requestModal" class="modal"><div class="modal-box"><button class="close" id="closeRequests">✕</button><h2>Friend requests</h2><div id="requestList" class="list"></div></div></div>
