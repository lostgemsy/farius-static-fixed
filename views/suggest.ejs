<%- include('parts/topbar') %><main class="page"><h1>💡 Suggest a feature</h1><div class="card"><p class="muted">Signed-in users can send ideas for Farius.</p><div class="field"><textarea id="suggestion" rows="5" maxlength="500" placeholder="What should we add?"></textarea></div><button class="primary" id="sendSuggestion">Submit suggestion</button><p id="suggestMsg" class="muted"></p></div><h2>Recent suggestions</h2><div id="suggestions" class="list"></div></main><script type="module">const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function load(){let d=await fetch('/api/suggestions').then(r=>r.json());document.querySelector('#suggestions').innerHTML=d.slice(0,50).map(x=>`<div class="row"><span>${esc(x.text)}</span><span class="muted">by ${esc(x.by)}</span></div>`).join('')||'<div class="card">No suggestions yet.</div>'}document.querySelector('#sendSuggestion').onclick=async()=>{const token=localStorage.getItem('fariusToken');if(!token)return document.querySelector('#suggestMsg').textContent='Sign in first.';const text=document.querySelector('#suggestion').value;const r=await fetch('/api/suggestions',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+token},body:JSON.stringify({text})});const d=await r.json();document.querySelector('#suggestMsg').textContent=d.error||'Suggestion submitted!';if(r.ok){document.querySelector('#suggestion').value='';load()}};load();</script>